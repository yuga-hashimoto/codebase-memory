{
  "name": "codebase-memory",
  "version": "1.0.0",
  "description": "MCP server that gives AI agents persistent memory of your codebase. Remembers architecture decisions, patterns, conventions, and project context across sessions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codebase-memory": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "ai",
    "memory",
    "codebase",
    "context",
    "model-context-protocol",
    "cursor",
    "copilot",
    "claude"
  ],
  "author": "yuga-hashimoto",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.23.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
